<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud backup and device-to-device transfer: same exclusions as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="mitm/" />
        <exclude domain="sharedpref" path="wigle.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="mitm/" />
        <exclude domain="sharedpref" path="wigle.xml" />
    </device-transfer>
</data-extraction-rules>
