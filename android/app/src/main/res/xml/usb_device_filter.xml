<?xml version="1.0" encoding="utf-8"?>
<!--
  USB vendor IDs that identify a Brucia/Bruce-class ESP32 board, so Android offers to open the app
  (and grants USB permission) when one is plugged in. Vendor-only so any PID on these bridges matches:
    0x303a Espressif native USB-CDC (ESP32-S3/S2/C3 - the T-Embed CC1101 reference board)
    0x10c4 Silicon Labs CP210x        0x1a86 WCH CH340/CH9102
    0x0403 FTDI                        0x067b Prolific PL2303
-->
<resources>
    <usb-device vendor-id="0x303a" />
    <usb-device vendor-id="0x10c4" />
    <usb-device vendor-id="0x1a86" />
    <usb-device vendor-id="0x0403" />
    <usb-device vendor-id="0x067b" />
</resources>
